{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Bauhaus Design Token System",
    "author": "dotdesxgn",
    "version": "2.0.0",
    "philosophy": "Form follows function. Every token earns its place."
  },
  "color": {
    "red":      { "$value": "#D72B2B", "$type": "color", "$description": "Circle — tension, action, accent" },
    "blue":     { "$value": "#1C3F94", "$type": "color", "$description": "Square — structure, trust, nav" },
    "yellow":   { "$value": "#F5C518", "$type": "color", "$description": "Triangle — energy, highlight, CTA" },
    "black":    { "$value": "#111111", "$type": "color", "$description": "Primary text, borders, all lines" },
    "white":    { "$value": "#F5F2EC", "$type": "color", "$description": "Warm off-white — never pure #FFFFFF" },
    "paper":    { "$value": "#EDE9E0", "$type": "color", "$description": "Distressed paper — brand background" },
    "gray":     { "$value": "#888880", "$type": "color", "$description": "Secondary text, disabled, eyebrows" },
    "charcoal": { "$value": "#2C2C2A", "$type": "color", "$description": "Dark surfaces, inverse sections" }
  },
  "typography": {
    "scale": {
      "xs":   { "$value": "10px"  },
      "sm":   { "$value": "12px"  },
      "base": { "$value": "16px"  },
      "md":   { "$value": "21px"  },
      "lg":   { "$value": "28px"  },
      "xl":   { "$value": "38px"  },
      "2xl":  { "$value": "50px"  },
      "3xl":  { "$value": "67px"  },
      "4xl":  { "$value": "89px"  },
      "5xl":  { "$value": "120px" }
    },
    "families": {
      "bauhaus-display":    { "$value": "Josefin Sans 700" },
      "bauhaus-body":       { "$value": "Josefin Sans 300" },
      "industrial-display": { "$value": "Bebas Neue" },
      "industrial-body":    { "$value": "Oswald 400" },
      "digital-display":    { "$value": "IBM Plex Mono 700" },
      "digital-body":       { "$value": "IBM Plex Sans 400" },
      "now-display":        { "$value": "Inter 900" },
      "now-body":           { "$value": "Space Grotesk 400" },
      "hook-display":       { "$value": "DM Serif Display Italic" },
      "meta":               { "$value": "Space Mono 400" }
    }
  },
  "spacing": {
    "1":  { "$value": "8px"   },
    "2":  { "$value": "16px"  },
    "3":  { "$value": "24px"  },
    "4":  { "$value": "32px"  },
    "5":  { "$value": "40px"  },
    "6":  { "$value": "48px"  },
    "8":  { "$value": "64px"  },
    "10": { "$value": "80px"  },
    "12": { "$value": "96px"  },
    "16": { "$value": "128px" }
  },
  "border": {
    "thin":   { "$value": "0.5px solid #111111" },
    "std":    { "$value": "1px solid #111111"   },
    "heavy":  { "$value": "2px solid #111111"   },
    "accent": { "$value": "4px solid #D72B2B"   }
  },
  "radius": {
    "none": { "$value": "0"      },
    "sm":   { "$value": "4px"    },
    "lg":   { "$value": "12px"   },
    "pill": { "$value": "999px"  }
  },
  "motion": {
    "easing-bauhaus": { "$value": "cubic-bezier(0.19, 1, 0.22, 1)" },
    "duration-fast":  { "$value": "150ms" },
    "duration-base":  { "$value": "300ms" },
    "duration-slow":  { "$value": "600ms" }
  },
  "canvas": {
    "instagram-square":   { "$value": "1080x1080px" },
    "instagram-portrait": { "$value": "1080x1350px" },
    "slide-padding":      { "$value": "52px" },
    "web-max-width":      { "$value": "1440px" }
  }
}
