{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Bauhaus Design Token System",
    "author": "dotdesxgn",
    "version": "2.0.0",
    "philosophy": "Form follows function. Every token earns its place."
  },
  "color": {
    "$description": "Kandinsky's primary color-form theory encoded as tokens",
    "red": {
      "$value": "#D72B2B",
      "$type": "color",
      "$description": "Circle — tension, action, urgency, accent"
    },
    "blue": {
      "$value": "#1C3F94",
      "$type": "color",
      "$description": "Square — structure, stability, trust, navigation"
    },
    "yellow": {
      "$value": "#F5C518",
      "$type": "color",
      "$description": "Triangle — energy, warning, highlight, CTA"
    },
    "black": {
      "$value": "#111111",
      "$type": "color",
      "$description": "Primary text, borders, all structural lines"
    },
    "white": {
      "$value": "#F5F2EC",
      "$type": "color",
      "$description": "Warm off-white. Never use pure #FFFFFF"
    },
    "paper": {
      "$value": "#EDE9E0",
      "$type": "color",
      "$description": "Your brand neutral — distressed paper texture base"
    },
    "gray": {
      "$value": "#888880",
      "$type": "color",
      "$description": "Secondary text, disabled states, eyebrow labels"
    },
    "charcoal": {
      "$value": "#2C2C2A",
      "$type": "color",
      "$description": "Dark surfaces, inverse sections, dark overlays"
    }
  },
  "typography": {
    "$description": "All sizes derived from perfect fourth ratio (1.333x)",
    "scale": {
      "xs":   { "$value": "10px", "$description": "Eyebrow, meta, legal, stamps" },
      "sm":   { "$value": "12px", "$description": "Captions, tags, pills, counters" },
      "base": { "$value": "16px", "$description": "Body copy — never exceed 60ch width" },
      "md":   { "$value": "21px", "$description": "Subheadings" },
      "lg":   { "$value": "28px", "$description": "Section titles" },
      "xl":   { "$value": "38px", "$description": "Card headlines" },
      "2xl":  { "$value": "50px", "$description": "Page sections" },
      "3xl":  { "$value": "67px", "$description": "Hero subheads" },
      "4xl":  { "$value": "89px", "$description": "Hero display" },
      "5xl":  { "$value": "120px", "$description": "Poster / landmark / landmark type" }
    },
    "families": {
      "bauhaus-display": { "$value": "Josefin Sans", "$description": "1919 Bauhaus era — geometric, spaced, no serifs" },
      "industrial-display": { "$value": "Bebas Neue", "$description": "1920s–60s factory era — condensed, heavy" },
      "industrial-body": { "$value": "Oswald", "$description": "Industrial body — condensed sans" },
      "digital-display": { "$value": "IBM Plex Mono", "$description": "1990s–2010s screen era — monospaced precision" },
      "digital-body": { "$value": "IBM Plex Sans", "$description": "Digital body — IBM's human interface type" },
      "now-display": { "$value": "Inter", "$description": "2026 — the internet's native font" },
      "now-body": { "$value": "Space Grotesk", "$description": "Post-Bauhaus web native" },
      "hook-display": { "$value": "DM Serif Display", "$description": "Editorial hook — italic serif for wit and contrast" },
      "meta": { "$value": "Space Mono", "$description": "All timestamps, counters, tags, eyebrows, stamps" }
    },
    "lineHeight": {
      "tight":   { "$value": "0.85", "$description": "Poster/landmark display only" },
      "display": { "$value": "0.88", "$description": "Large headlines" },
      "heading": { "$value": "1.1",  "$description": "Subheadings" },
      "body":    { "$value": "1.65", "$description": "All body copy" },
      "loose":   { "$value": "1.8",  "$description": "Wide-measure editorial" }
    },
    "letterSpacing": {
      "tight":    { "$value": "-0.03em", "$description": "Heavy display at large sizes" },
      "display":  { "$value": "-0.02em", "$description": "Standard display" },
      "normal":   { "$value": "0em" },
      "wide":     { "$value": "0.05em",  "$description": "Subheadings" },
      "wider":    { "$value": "0.1em",   "$description": "Tags, labels" },
      "widest":   { "$value": "0.18em",  "$description": "Eyebrow / meta text" },
      "stamp":    { "$value": "0.2em",   "$description": "Rotated stamps, era labels" }
    }
  },
  "spacing": {
    "$description": "All values are multiples of 8px base unit",
    "1": { "$value": "8px" },
    "2": { "$value": "16px" },
    "3": { "$value": "24px" },
    "4": { "$value": "32px" },
    "5": { "$value": "40px" },
    "6": { "$value": "48px" },
    "8": { "$value": "64px" },
    "10": { "$value": "80px" },
    "12": { "$value": "96px" },
    "16": { "$value": "128px" }
  },
  "border": {
    "thin":   { "$value": "0.5px solid #111111", "$description": "Editorial rules, grid lines" },
    "std":    { "$value": "1px solid #111111",   "$description": "Component borders" },
    "heavy":  { "$value": "2px solid #111111",   "$description": "Emphasis borders" },
    "accent": { "$value": "4px solid #D72B2B",   "$description": "Red accent bar — pull quotes, cards, left borders" }
  },
  "radius": {
    "none": { "$value": "0",     "$description": "DEFAULT — Bauhaus hates rounded corners on structure" },
    "sm":   { "$value": "4px",   "$description": "Subtle rounding on UI micro-components only" },
    "lg":   { "$value": "12px",  "$description": "App icons, image thumbnails" },
    "pill": { "$value": "999px", "$description": "Status badges only — never structural" }
  },
  "motion": {
    "easing": {
      "bauhaus": { "$value": "cubic-bezier(0.19, 1, 0.22, 1)", "$description": "Mechanical precision — no bounce" }
    },
    "duration": {
      "fast":  { "$value": "150ms" },
      "base":  { "$value": "300ms" },
      "slow":  { "$value": "600ms" }
    }
  },
  "layout": {
    "canvas": {
      "instagram-square": { "$value": "1080x1080px", "$description": "Standard Instagram carousel slide" },
      "instagram-portrait": { "$value": "1080x1350px", "$description": "4:5 portrait — better feed performance" },
      "web-max": { "$value": "1440px", "$description": "Maximum content width" },
      "padding-standard": { "$value": "52px", "$description": "Slide and page padding all sides" }
    },
    "grid": {
      "columns": { "$value": "12" },
      "gutter": { "$value": "8px" },
      "base-unit": { "$value": "8px" }
    }
  }
}
